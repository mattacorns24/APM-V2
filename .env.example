# Template for .env — copy to .env and fill in values
# cp .env.example .env

ANTHROPIC_API_KEY=

# Alpaca paper trading (https://app.alpaca.markets — generate Paper API keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Discord webhook for daily/weekly report notifications (Discord: Server
# Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL).
# Unset = notify.py prints the message instead of sending it.
DISCORD_WEBHOOK_URL=
